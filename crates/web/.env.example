# Copy to `crates/web/.env` (that exact path — `main.rs` loads
# `$CARGO_MANIFEST_DIR/.env`, not the repo root) and fill in.
#
# Every variable here is read with `.expect(...)` at startup, so a missing
# one is a panic before the server binds, not a warning.

# ---------------------------------------------------------------------------
# Core services — both are started by `devenv up`.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://localhost/chess_dev
REDIS_URL=redis://127.0.0.1:6379

# "development" or "production". Controls whether the session cookie is
# marked Secure and whether HSTS is sent, so it must be "production" behind
# HTTPS and anything else locally (a Secure cookie is dropped over plain
# HTTP, which silently breaks login).
ENV=development

# ---------------------------------------------------------------------------
# GitHub OAuth
#
# Create one at https://github.com/settings/developers → "New OAuth App".
# The callback URL must match GITHUB_REDIRECT_URI exactly, including port.
# ---------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/auth/github/callback

# ---------------------------------------------------------------------------
# Google OAuth (OpenID Connect)
#
# Create one at https://console.cloud.google.com/apis/credentials →
# "Create credentials" → "OAuth client ID" → "Web application", then add
# GOOGLE_REDIRECT_URI under "Authorized redirect URIs".
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# ---------------------------------------------------------------------------
# Set automatically by Fly in production; leave unset locally, where it
# falls back to the instance id "local". It identifies which instance owns a
# given game, for the fly-replay routing in `main.rs`.
# ---------------------------------------------------------------------------
# FLY_MACHINE_ID=
