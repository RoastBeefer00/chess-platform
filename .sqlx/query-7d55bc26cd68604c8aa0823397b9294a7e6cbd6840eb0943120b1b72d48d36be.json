  "query": "SELECT u.id, u.username, u.avatar_url\n               FROM friendships f\n               JOIN users u ON u.id = f.requester_id\n               WHERE f.addressee_id = $1 AND f.status = 'pending'\n               ORDER BY f.created_at DESC",
