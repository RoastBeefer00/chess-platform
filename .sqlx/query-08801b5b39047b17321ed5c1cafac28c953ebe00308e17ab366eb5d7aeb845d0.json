  "query": "SELECT u.id, u.email, u.username, u.avatar_url, u.bio, u.country, u.created_at, u.is_guest, u.settings AS \"settings: Json<UserSettings>\"\n                       FROM users u\n                       JOIN oauth_accounts oa ON oa.user_id = u.id\n                       WHERE oa.provider = 'google' AND oa.provider_user_id = $1",
