  "query": "SELECT u.id, u.username, u.avatar_url\n               FROM friendships f\n               JOIN users u ON u.id = f.addressee_id\n               WHERE f.requester_id = $1 AND f.status = 'pending'\n               ORDER BY f.created_at DESC",
